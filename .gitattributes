data/corpus-pt-v1/** text eol=lf
data/corpus-pt-v1/tokenizer/*.bin binary
# Preserve the upstream license snapshot byte-for-byte, including its whitespace.
data/corpus-pt-v1/licenses/PYTHON-LICENSE.html -whitespace
data/language-pilot/*.json text eol=lf
evaluation/*.json text eol=lf
reports/corpus-pt-v1/** text eol=lf
requirements-corpus.txt text eol=lf
data/neural-dialogue-v2/** text eol=lf
data/neural-dialogue-v2/sources/** -text -whitespace
data/neural-dialogue-v2/dialogues/UPSTREAM-CARD.md -whitespace
data/neural-dialogue-v2/literature/*.bin binary
reports/neural-dialogue-v2/** text eol=lf
# Keep prepared-data hashes valid on Windows with core.autocrlf enabled.
data/aira-pt-v1/** text eol=lf
data/aira-pt-v1/*.gz binary
data/aira-pt-v1/SOURCE-* -text -whitespace
data/foundation-pt-v1/** text eol=lf
data/foundation-pt-v1/tokenizer/*.bin binary
data/foundation-pt-v1/sources/** -text -whitespace
data/curriculum-v2/** text eol=lf
data/curriculum-v2/*.gz binary
data/curriculum-v2/SOURCE-* -text -whitespace
data/source-locks/** text eol=lf
configs/foundation*.yaml text eol=lf
reports/curriculum-v2/** text eol=lf
scripts/*.ps1 text eol=lf

# Historical audit inputs have frozen byte hashes; do not rewrite on checkout.
data/corpus-v0.5/** -text

# Browser SRI depends on exact bytes, even under Windows core.autocrlf=true.
interface/web/vendor/** -text
interface/web/index.html text eol=lf
interface/web/src/** text eol=lf

# Conversation-v3 preparation and its source notices are immutable audit inputs.
data/conversation-v3/*.json text eol=lf
data/conversation-v3/*.gz binary
data/conversation-v3/SOURCE-* -text -whitespace
reports/conversation-v3/** text eol=lf
