{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E.L.Y.S.I.A.",
  "version": "0.1.0",
  "identifier": "com.lorran1690.elysia",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "E.L.Y.S.I.A. Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
